<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>online.yudream.plugins</groupId>
        <artifactId>yudream-admin-plugins</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>yudream-plugin-registration-review</artifactId>
    <version>0.4.0</version>
    <name>YuDream Plugin - Registration Review</name>
    <description>注册审核问卷：复用题库插件抽题与判分，独立保存申请状态、审核记录和配置；B站三连由后续插件接入。</description>

    <dependencies>
        <dependency>
            <groupId>online.yudream.base</groupId>
            <artifactId>yudream-plugin-spi</artifactId>
        </dependency>
        <dependency>
            <groupId>online.yudream.plugins</groupId>
            <artifactId>yudream-plugin-questionbank</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>online.yudream.plugins</groupId>
            <artifactId>yudream-plugin-bilibili-triple</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.11.4</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
        </plugins>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>../../yudream-frontend/packages/plugin-registration-review/dist</directory>
                <targetPath>META-INF/yudream-plugin/frontend/registration-review</targetPath>
            </resource>
        </resources>
    </build>
</project>
